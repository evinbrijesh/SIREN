# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
dist/
.vite/

# --- Data (never commit rasters or downloaded scenes) ---
data/raw/*
data/processed/*
data/archived_disqualified/
data/datasets/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
backend/*.db
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- ML training artifacts (not referenced by code; checkpoints live in models/checkpoints) ---
backend/checkpoints/
backend/models/
*.bak

# --- Disqualified weights (audit record lives in JSON sidecars; ADR-011.1) ---
# Only the gate-passing v1 checkpoint is tracked. v1_best and v2_finetuned
# weights failed the precision floor and are excluded from git history.
models/checkpoints/water_resunet_kuro_siwo_full/*.pt
!models/checkpoints/water_resunet_kuro_siwo_full/water_resunet_6ch_kuro_siwo_v1.pt

# --- Redundant design archives (extracted dirs are committed) ---
docs/*.zip
docs/archive/
.~lock.*

# --- Env / secrets ---
.env
.env.*
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.~lock.*

# --- Build artifacts ---
*.log
coverage/
htmlcov/